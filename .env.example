# =============================================================================
# AL-RIFAI AI OPERATIONS PLATFORM - Environment Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
#
# Secrets are managed via Docker secrets or the .env file below.
# All credentials are NEW-PLATFORM credentials. Do NOT reuse production
# credentials from chat.iamazim.com or Fazle-Core.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_SECRET_KEY=changeme-set-a-strong-random-secret

# --- PostgreSQL (new platform database) ---
POSTGRES_HOST=alrifai-postgres
POSTGRES_PORT=5434
POSTGRES_DB=alrifai
POSTGRES_USER=alrifai
POSTGRES_PASSWORD=changeme-set-a-strong-password

# --- Open WebUI ---
OWH_HOST=0.0.0.0
OWH_PORT=8080
WEBUI_SECRET_KEY=changeme-set-a-strong-webui-secret
WEBUI_AUTH=true
ENABLE_SIGNUP=false
DEFAULT_MODELS=phi4-mini:latest

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434

# --- 9Router ---
NINE_ROUTER_URL=http://9router:20128/v1
NINE_ROUTER_API_KEY=REQUIRED-from-9router-data-auth-cli-secret

# --- Admin Dashboard (9Router) ---
NINE_ROUTER_DASHBOARD_URL=http://127.0.0.1:20129/dashboard

# --- Email / Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Monitoring ---
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# --- Scheduler ---
SCHEDULER_TZ=Asia/Dhaka
